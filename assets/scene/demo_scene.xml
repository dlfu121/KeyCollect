<!--
  Demo MuJoCo scene for MuJoCo-LeRobot integration.
  This is a PLACEHOLDER scene. Replace with your actual robot scene.

  The scene defines:
  - A simple 6-DOF robot arm with gripper
  - A table workspace
  - A cabinet with a door (for open_cabinet_door task)
  - A screwdriver object (for pick_screwdriver task)
  - Named cameras for observation
-->
<mujoco model="demo_scene">
  <compiler angle="radian" meshdir="../robot/meshes"/>

  <option timestep="0.002" gravity="0 0 -9.81" integrator="implicitfast"/>

  <default>
    <joint armature="0.01" damping="0.5"/>
    <geom condim="4" friction="1 0.5 0.01"/>
    <motor ctrllimited="true" ctrlrange="-1 1"/>
  </default>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.6 0.7 0.8" rgb2="0.2 0.2 0.4" width="512" height="512"/>
    <texture name="texplane" type="2d" builtin="checker" rgb1="0.8 0.8 0.8" rgb2="0.6 0.6 0.6" width="512" height="512"/>
    <material name="matplane" texture="texplane" texrepeat="5 5" reflectance="0.1"/>
    <material name="metal" rgba="0.7 0.7 0.75 1" specular="0.5" shininess="0.3"/>
    <material name="plastic" rgba="0.2 0.6 0.9 1"/>
    <material name="wood" rgba="0.6 0.4 0.2 1"/>
    <material name="red" rgba="0.9 0.2 0.1 1"/>
  </asset>

  <worldbody>
    <!-- Ground plane -->
    <geom name="floor" type="plane" size="2 2 0.1" material="matplane" pos="0 0 0"/>

    <!-- Light -->
    <light directional="true" diffuse="0.8 0.8 0.8" specular="0.3 0.3 0.3" pos="0 0 4" dir="0 0 -1"/>

    <!-- Table -->
    <body name="table" pos="0.5 0 0.35">
      <geom name="table_top" type="box" size="0.4 0.5 0.02" material="wood" pos="0 0 0"/>
      <geom name="leg1" type="cylinder" size="0.03 0.35" material="wood" pos="0.3 0.4 -0.35"/>
      <geom name="leg2" type="cylinder" size="0.03 0.35" material="wood" pos="-0.3 0.4 -0.35"/>
      <geom name="leg3" type="cylinder" size="0.03 0.35" material="wood" pos="0.3 -0.4 -0.35"/>
      <geom name="leg4" type="cylinder" size="0.03 0.35" material="wood" pos="-0.3 -0.4 -0.35"/>
    </body>

    <!-- Robot base -->
    <body name="robot_base" pos="0 0 0.37">
      <geom name="base" type="cylinder" size="0.08 0.05" material="metal"/>

      <!-- Joint 1: Shoulder Yaw -->
      <body name="link1" pos="0 0 0.05">
        <joint name="joint1" type="hinge" axis="0 0 1" range="-3.14 3.14"/>
        <geom name="link1_geom" type="capsule" fromto="0 0 0 0 0 0.15" size="0.04" material="metal"/>

        <!-- Joint 2: Shoulder Pitch -->
        <body name="link2" pos="0 0 0.15">
          <joint name="joint2" type="hinge" axis="0 1 0" range="-1.57 1.57"/>
          <geom name="link2_geom" type="capsule" fromto="0 0 0 0.2 0 0" size="0.035" material="metal"/>

          <!-- Joint 3: Elbow Pitch -->
          <body name="link3" pos="0.2 0 0">
            <joint name="joint3" type="hinge" axis="0 1 0" range="-2.35 2.35"/>
            <geom name="link3_geom" type="capsule" fromto="0 0 0 0.18 0 0" size="0.03" material="plastic"/>

            <!-- Joint 4: Wrist Roll -->
            <body name="link4" pos="0.18 0 0">
              <joint name="joint4" type="hinge" axis="1 0 0" range="-3.14 3.14"/>
              <geom name="link4_geom" type="capsule" fromto="0 0 0 0.1 0 0" size="0.025" material="plastic"/>

              <!-- Joint 5: Wrist Pitch -->
              <body name="link5" pos="0.1 0 0">
                <joint name="joint5" type="hinge" axis="0 1 0" range="-1.57 1.57"/>
                <geom name="link5_geom" type="capsule" fromto="0 0 0 0.08 0 0" size="0.02" material="plastic"/>

                <!-- Joint 6: Wrist Roll (tool) -->
                <body name="link6" pos="0.08 0 0">
                  <joint name="joint6" type="hinge" axis="1 0 0" range="-3.14 3.14"/>
                  <geom name="link6_geom" type="cylinder" size="0.025 0.02" material="metal"/>

                  <!-- Gripper base -->
                  <body name="gripper_base" pos="0.02 0 0">
                    <geom name="gripper_base_geom" type="box" size="0.02 0.03 0.015" material="metal"/>

                    <!-- Left finger -->
                    <body name="finger_left" pos="0.02 0.015 0">
                      <joint name="finger_left_joint" type="slide" axis="0 1 0" range="0 0.04"/>
                      <geom name="finger_left_geom" type="box" size="0.03 0.005 0.01" material="metal" pos="0.01 0 0"/>
                    </body>

                    <!-- Right finger -->
                    <body name="finger_right" pos="0.02 -0.015 0">
                      <joint name="finger_right_joint" type="slide" axis="0 -1 0" range="0 0.04"/>
                      <geom name="finger_right_geom" type="box" size="0.03 0.005 0.01" material="metal" pos="0.01 0 0"/>
                    </body>

                    <!-- EE Site (End Effector) -->
                    <site name="ee_site" pos="0.04 0 0" size="0.005" rgba="1 0 0 1"/>
                  </body>
                </body>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>

    <!-- Cabinet -->
    <body name="cabinet" pos="0.8 0 0.5">
      <geom name="cabinet_body" type="box" size="0.2 0.3 0.3" material="wood" pos="0 0 0"/>
      <!-- Cabinet door -->
      <body name="cabinet_door" pos="0.2 0.2 0">
        <joint name="door_hinge" type="hinge" axis="0 0 1" range="0 1.57" damping="0.1"/>
        <geom name="door_geom" type="box" size="0.01 0.2 0.3" material="wood" pos="0.01 0 0"/>
        <!-- Door handle -->
        <geom name="handle" type="cylinder" size="0.01 0.04" material="metal" pos="0.02 0.12 0" euler="1.5708 0 0"/>
      </body>
    </body>

    <!-- Screwdriver (for pick_screwdriver task) -->
    <body name="screwdriver" pos="0.5 0.15 0.39">
      <joint name="screwdriver_free" type="free"/>
      <geom name="screwdriver_handle" type="capsule" fromto="0 0 -0.06 0 0 0.06" size="0.012" material="red"/>
      <geom name="screwdriver_shaft" type="capsule" fromto="0 0 0.06 0 0 0.14" size="0.004" material="metal"/>
    </body>

    <!-- Named cameras -->
    <camera name="camera_front" pos="1.0 0 0.8" xyaxes="0 1 0 -0.5 0 0.866" fovy="60"/>
    <camera name="camera_side" pos="0 1.0 0.8" xyaxes="-1 0 0 0 -0.5 0.866" fovy="60"/>
    <camera name="camera_top" pos="0.5 0 1.5" xyaxes="0 1 0 -1 0 0" fovy="60"/>

    <!-- Camera position markers for the main view -->
    <body name="camera_front_marker" pos="1.0 0 0.8">
      <geom name="camera_front_marker_geom" type="sphere" size="0.02" rgba="1 0.8 0.1 1" contype="0" conaffinity="0"/>
    </body>
    <body name="camera_side_marker" pos="0 1.0 0.8">
      <geom name="camera_side_marker_geom" type="sphere" size="0.02" rgba="0.1 0.9 1 1" contype="0" conaffinity="0"/>
    </body>
  </worldbody>

  <actuator>
    <motor name="act_joint1" joint="joint1" gear="50"/>
    <motor name="act_joint2" joint="joint2" gear="50"/>
    <motor name="act_joint3" joint="joint3" gear="30"/>
    <motor name="act_joint4" joint="joint4" gear="20"/>
    <motor name="act_joint5" joint="joint5" gear="20"/>
    <motor name="act_joint6" joint="joint6" gear="10"/>
    <motor name="act_finger_left" joint="finger_left_joint" gear="10"/>
    <motor name="act_finger_right" joint="finger_right_joint" gear="10"/>
    <position name="pos_door" joint="door_hinge" kp="20"/>
  </actuator>
</mujoco>
